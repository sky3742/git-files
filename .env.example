# Server port
PORT=7005
# URL base path (e.g. /repos)
BASE_PATH=/
# Bare repositories directory (absolute, or relative to the working directory).
# Windows: REPOS_DIR=D:\projects\repo — backslashes are taken literally in .env
# (no escaping needed; forward slashes D:/projects/repo also work).
# Defaults to repos/ next to server.js when unset.
# REPOS_DIR=/srv/git/repos
